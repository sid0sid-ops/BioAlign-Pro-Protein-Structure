# ─── App ──────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:4000

# ─── Database (PostgreSQL) ─────────────────────────────────────────────
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
DATABASE_URL=postgresql://bioalign:bioalign_dev@localhost:5432/bioalign?schema=public

# ─── Redis (Caching) ───────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ─── External API Keys (optional — public APIs work without these) ─────
# NCBI Entrez (increases rate limits from 3/s to 10/s)
NCBI_API_KEY=

# UniProt (standard public API — no key required, but set user agent)
UNIPROT_CONTACT_EMAIL=your@email.com

# ─── Auth (if you add user accounts in future) ─────────────────────────
JWT_SECRET=change-me-to-a-long-random-secret-minimum-32-chars
JWT_EXPIRY=7d

# ─── Deployment ────────────────────────────────────────────────────────
NODE_ENV=development
PORT=4000

# ─── Vercel (for GitHub Actions deploy) ────────────────────────────────
VERCEL_TOKEN=
VERCEL_ORG_ID=
VERCEL_PROJECT_ID=

# ─── Railway (for API deploy via GitHub Actions) ──────────────────────
RAILWAY_TOKEN=
