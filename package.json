{
  "name": "protein-structure-workbench",
  "version": "1.0.0",
  "private": true,
  "description": "A modular full-stack protein structure prediction and bioinformatics workbench.",
  "scripts": {
    "dev": "next dev --webpack -p 3000",
    "dev:api": "tsx watch server/index.ts",
    "dev:full": "concurrently \"npm:dev\" \"npm:dev:api\"",
    "build": "npm run data:build && next build --webpack",
    "build:static": "npm run build",
    "data:build": "node scripts/build-data/index.mjs",
    "data:fetch-public": "node scripts/fetch-public-data/index.mjs",
    "data:normalize": "node scripts/normalize-data/index.mjs",
    "data:index": "node scripts/build-search-index/index.mjs",
    "models:convert": "node scripts/convert-models/index.mjs",
    "assets:compress": "node scripts/compress-assets/index.mjs",
    "start": "next start -p 3000",
    "api:start": "node dist/server/index.js",
    "preview:static": "npx -y serve@latest out -l 4173",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.server.json --noEmit",
    "format": "prettier --write .",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prepare": "husky"
  },
  "dependencies": {
    "@hookform/resolvers": "latest",
    "@prisma/client": "latest",
    "@radix-ui/react-dialog": "latest",
    "@radix-ui/react-dropdown-menu": "latest",
    "@radix-ui/react-progress": "latest",
    "@radix-ui/react-scroll-area": "latest",
    "@radix-ui/react-select": "latest",
    "@radix-ui/react-separator": "latest",
    "@radix-ui/react-slot": "latest",
    "@radix-ui/react-switch": "latest",
    "@radix-ui/react-tabs": "latest",
    "@react-three/drei": "latest",
    "@react-three/fiber": "latest",
    "@tanstack/react-query": "latest",
    "axios": "latest",
    "bcryptjs": "latest",
    "bottleneck": "^2.19.5",
    "class-variance-authority": "latest",
    "clsx": "latest",
    "compression": "latest",
    "cors": "latest",
    "d3": "latest",
    "express": "latest",
    "express-rate-limit": "latest",
    "framer-motion": "latest",
    "fuse.js": "^7.3.0",
    "graphql-request": "^7.4.0",
    "gsap": "latest",
    "helmet": "latest",
    "ioredis": "latest",
    "jsonwebtoken": "latest",
    "lucide-react": "latest",
    "molstar": "latest",
    "morgan": "latest",
    "multer": "latest",
    "next": "latest",
    "next-themes": "latest",
    "ngl": "latest",
    "onnxruntime-web": "^1.26.0",
    "p-limit": "^3.1.0",
    "plotly.js-dist-min": "latest",
    "react": "latest",
    "react-dom": "latest",
    "react-hook-form": "latest",
    "react-plotly.js": "latest",
    "recharts": "latest",
    "sonner": "latest",
    "tailwind-merge": "latest",
    "tailwindcss-animate": "latest",
    "three": "latest",
    "uuid": "latest",
    "zod": "latest",
    "zustand": "latest"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "latest",
    "@types/bcryptjs": "latest",
    "@types/compression": "latest",
    "@types/cors": "latest",
    "@types/d3": "latest",
    "@types/express": "latest",
    "@types/jsonwebtoken": "latest",
    "@types/morgan": "latest",
    "@types/multer": "latest",
    "@types/node": "latest",
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "@types/react-plotly.js": "latest",
    "@types/three": "latest",
    "@types/uuid": "latest",
    "autoprefixer": "latest",
    "concurrently": "latest",
    "eslint": "latest",
    "eslint-config-next": "latest",
    "husky": "latest",
    "lint-staged": "latest",
    "postcss": "latest",
    "prettier": "latest",
    "prisma": "latest",
    "tailwindcss": "latest",
    "tsx": "latest",
    "typescript": "latest"
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md,css,scss}": [
      "prettier --write"
    ]
  }
}
